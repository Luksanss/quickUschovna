<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the Info.plist Xcode generates. Sparkle's settings (docs/architecture.md § Updates):
     it checks only when asked, never installs by itself, sends no system profile, and checks the
     EdDSA signature before it unpacks anything. -->
<plist version="1.0">
<dict>
	<key>SUFeedURL</key>
	<string>https://github.com/Luksanss/quickUschovna/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>lRgwXvQva0v4fD+PtKvNVLqQ+1AJSAClZ2hW4CRm1lo=</string>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
	<key>SUEnableSystemProfiling</key>
	<false/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Files and Folders to Send</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.item</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
